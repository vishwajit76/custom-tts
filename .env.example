# --- auth / protection ---
# comma separated; empty = auth disabled (dev only)
API_KEYS=change-me-1,change-me-2
# requests (HTTP calls / WS connections) per key per minute, per process
RATE_LIMIT_PER_MINUTE=600
# concurrent synthesis streams per process; beyond -> 503 / WS "overloaded"
MAX_STREAMS=64

# --- engines ---
# comma list, loaded side by side; voice ids are unique across engines (piper: hi_IN-rohan-medium,
# supertonic:F1..F5/M1..M5, kokoro:hf_alpha/hf_beta/hm_omega/hm_psi). GET /v1/voices lists them all.
#   piper       real-time CPU/GPU (default)
#   supertonic  Supertonic 3, 10 voices. requirements-engines.txt; weights ~400 MB. Weights are OpenRAIL-M: commercial
#               use allowed, but its use restrictions bind you and your users, e.g. output must be disclosed as
#               machine generated (tell callers they hear an AI), no impersonation. Read models/supertonic3/LICENSE.
#   kokoro      Kokoro-82M v1.0 Hindi, 4 voices. requirements-engines.txt; weights ~354 MB, Apache-2.0
#   qwen3       zero-shot cloning, needs NVIDIA GPU + requirements-qwen.txt; runs alone
# weights: python scripts/download_voices.py hi_IN-rohan-medium supertonic kokoro
ENGINES=piper
# SUPERTONIC_DIR=models/supertonic3
# denoising steps: fewer = faster, rougher
# SUPERTONIC_STEPS=8
# KOKORO_DIR=models/kokoro
# every *.onnx + *.onnx.json here is a voice
MODELS_DIR=models/piper
# extra directories (comma list) whose *.onnx voices are added. voices -> hi_IN-custom-medium, the fine-tuned custom Hindi voice
# (personal, non-commercial use only; see docs/custom-voice-runbook.md). Uncomment to expose it; the default voice is unchanged.
MODELS_EXTRA=voices
# what voice="default" resolves to (any id from /v1/voices). To make the custom voice the default: DEFAULT_VOICE=hi_IN-custom-medium (needs MODELS_EXTRA=voices)
DEFAULT_VOICE=hi_IN-rohan-medium
# default: cores // THREADS_PER_WORKER
# WORKERS=2
# default: min(4, cores)
# THREADS_PER_WORKER=4
# USE_CUDA=false

# --- streaming ---
FIRST_CHUNK_CHARS=60
MAX_CHUNK_CHARS=120
LEAD_SILENCE_MS=30
# repeated phrases served from memory (~50 MB); 0 for benchmarks
CACHE_SIZE=256
LOG_LEVEL=INFO

# --- speaker registry ---
# how often (minutes) expired raw references are purged while running; 0 = only at startup and when a speaker is read
# RETENTION_SWEEP_MINUTES=60

# --- qwen3 engine only ---
# MODEL_PATH=Qwen/Qwen3-TTS-12Hz-1.7B-Base
# DEVICE=auto

# --- demo page: /demo (mic -> STT -> LLM -> our TTS) ---
# Vendor keys stay on the server and are never sent to the browser. A provider is offered only if its key is set.
# DEMO_ENABLED=true
# With API_KEYS empty, /demo, /demo/config and /demo/ws answer loopback clients only (others: 404 / WS close 1008),
# because they spend the vendor keys below. Set true only on a trusted network.
# DEMO_ALLOW_OPEN=false
# DEMO_MAX_TOKENS=300
# DEMO_TURN_TIMEOUT_S=60
# DEMO_TURNS_PER_MINUTE=20
# PLATFORM_SARVAM_API_KEY=
# PLATFORM_OPENAI_API_KEY=
# PLATFORM_GEMINI_API_KEY=
# PLATFORM_ELEVENLABS_API_KEY=
# empty = first provider with a key (STT: sarvam, openai, elevenlabs / LLM: openai, gemini, sarvam)
# DEMO_STT=
# DEMO_LLM=
# STT models
# DEMO_SARVAM_STT_MODEL=saaras:v3
# DEMO_OPENAI_STT_MODEL=gpt-transcribe
# DEMO_ELEVENLABS_STT_MODEL=scribe_v2
# LLM models: pick low time-to-first-token ones. Requests send reasoning_effort none (openai) / minimal (gemini) / null (sarvam)
# DEMO_OPENAI_LLM_MODEL=gpt-6-luna
# DEMO_GEMINI_LLM_MODEL=gemini-3.5-flash-lite
# DEMO_SARVAM_LLM_MODEL=sarvam-105b-conversations
# DEMO_SYSTEM_PROMPT=You are a polite Indian phone agent. Reply in natural spoken Hindi (Devanagari) ...

# --- optional: routing / DSP prosody / expressive engine (docs/voice-system.md) ---
# engine -> latency tier for routing_policy (fast|balanced|slow); measure on your hardware
# ENGINE_LATENCY_TIERS=piper:fast,supertonic:balanced,kokoro:balanced,expressive:slow,qwen:slow
# opt-in pitch/energy post-processing (labelled pitch:dsp / energy:dsp; NOT emotion)
# DSP_PROSODY=false
# a native-emotion engine, only with ENGINES=...,expressive (none ships; see app/services/expressive_engine.py)
# EXPRESSIVE_ENGINE=package.module:ClassName
